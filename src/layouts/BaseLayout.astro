---
import '../styles/global.css';

interface Props {
  title: string;
  lang: 'ko' | 'en';
  description?: string;
  isHome?: boolean;
  altHref?: string;
}

const { title, lang, description = '', isHome = false, altHref } = Astro.props;
const homeHref = `/${lang}/`;
const searchHref = `/${lang}/search/`;
const otherLang = lang === 'ko' ? 'en' : 'ko';
const langHref = altHref ?? `/${otherLang}/`;
---

<!doctype html>
<html lang={lang} data-pagefind-body>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — HOGAN</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('theme');
        var theme =
          saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        {
          isHome ? (
            <span />
          ) : (
            <a class="home-link" href={homeHref} aria-label="Home">
              HOGAN
            </a>
          )
        }
        <div class="header-tools">
          <a class="lang-toggle" href={langHref}>{otherLang}</a>
          <a href={searchHref}>Search</a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle theme">
            ☾/☀
          </button>
        </div>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var current = document.documentElement.getAttribute('data-theme');
          var next = current === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
        });
      })();
    </script>
  </body>
</html>
