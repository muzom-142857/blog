---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
---

<BaseLayout title="Search" lang="ko" altHref="/en/search/">
  <h1>Search</h1>
  <div id="search"></div>
  <link rel="stylesheet" href={withBase('/pagefind/pagefind-ui.css')} />
  <script is:inline src={withBase('/pagefind/pagefind-ui.js')}></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', function () {
      if (typeof PagefindUI === 'undefined') return;
      new PagefindUI({ element: '#search', showSubResults: true });
    });
  </script>
</BaseLayout>
